.container {
  padding: 24rpx;
}

.date-selector,
.time-slots,
.pile-info,
.summary-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #495057;
  margin-bottom: 16rpx;
}

.picker-value {
  font-size: 26rpx;
  color: #495057;
  padding: 16rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
  text-align: center;
}

.slots-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.time-slot {
  padding: 16rpx;
  border-radius: 8rpx;
  text-align: center;
  border: 1rpx solid #E9ECEF;
}

.time-slot.available {
  background: #E7F5FF;
  border-color: #4DABF7;
}

.time-slot.unavailable {
  background: #F8F9FA;
  border-color: #E9ECEF;
  opacity: 0.6;
}

.time-slot.selected {
  background: #4DABF7;
  border-color: #4DABF7;
}

.time-text {
  display: block;
  font-size: 24rpx;
  color: #495057;
  margin-bottom: 6rpx;
}

.status-text {
  display: block;
  font-size: 20rpx;
  color: #868E96;
}

.pile-item {
  padding: 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #E9ECEF;
  margin-bottom: 12rpx;
}

.pile-item.selected {
  border-color: #0CA678;
  background: #E6FCF5;
}

.pile-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #343A40;
  margin-bottom: 8rpx;
}

.pile-info-row {
  display: flex;
  padding: 6rpx 0;
}

.info-label {
  font-size: 24rpx;
  color: #868E96;
  margin-right: 12rpx;
}

.info-value {
  font-size: 24rpx;
  color: #495057;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.summary-label {
  font-size: 26rpx;
  color: #868E96;
}

.summary-value {
  font-size: 26rpx;
  color: #495057;
  font-weight: 500;
}

.action-buttons {
  margin-top: 32rpx;
}

.submit-btn {
  background: #4DABF7;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  border: none;
}
