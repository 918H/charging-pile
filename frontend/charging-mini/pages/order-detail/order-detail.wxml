<view class="container">
  <view class="status-card">
    <view class="status-icon">{{statusIcon}}</view>
    <text class="status-text">{{orderInfo.statusText}}</text>
  </view>

  <view class="info-section">
    <text class="section-title">订单信息</text>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{orderInfo.orderNumber}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">充电站</text>
      <text class="info-value">{{orderInfo.pileName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">充电量</text>
      <text class="info-value">{{orderInfo.powerConsumed}} kWh</text>
    </view>
    <view class="info-row">
      <text class="info-label">充电时长</text>
      <text class="info-value">{{orderInfo.durationMinutes}} 分钟</text>
    </view>
  </view>

  <view class="price-section">
    <text class="section-title">费用明细</text>
    <view class="price-row">
      <text class="price-label">电费</text>
      <text class="price-value">¥{{orderInfo.electricityFee?.toFixed(2)}}</text>
    </view>
    <view class="price-row">
      <text class="price-label">服务费</text>
      <text class="price-value">¥{{orderInfo.serviceFee?.toFixed(2)}}</text>
    </view>
    <view class="price-row" wx:if="{{orderInfo.discountAmount > 0}}">
      <text class="price-label">优惠</text>
      <text class="price-value text-success">-¥{{orderInfo.discountAmount?.toFixed(2)}}</text>
    </view>
    <view class="divider"></view>
    <view class="price-row total">
      <text class="price-label">实付</text>
      <text class="price-value text-primary">¥{{orderInfo.finalAmount?.toFixed(2)}}</text>
    </view>
  </view>

  <view class="time-section">
    <text class="section-title">时间信息</text>
    <view class="info-row">
      <text class="info-label">开始时间</text>
      <text class="info-value">{{formatDateTime(orderInfo.actualStart)}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">结束时间</text>
      <text class="info-value">{{formatDateTime(orderInfo.actualEnd)}}</text>
    </view>
  </view>

  <view class="action-buttons">
    <button wx:if="{{orderInfo.status === 0}}" class="btn-pay" bindtap="payOrder">立即支付</button>
    <button wx:if="{{orderInfo.status === 0}}" class="btn-cancel" bindtap="cancelOrder">取消订单</button>
    <button wx:if="{{orderInfo.status === 2}}" class="btn-review" bindtap="goToReview">评价</button>
    <button wx:if="{{orderInfo.status === 2}}" class="btn-refund" bindtap="goToRefund">申请退款</button>
  </view>
</view>
