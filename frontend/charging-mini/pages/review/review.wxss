.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.order-info {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.info-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.rating-section,
.tags-section,
.comment-section,
.image-section {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.rating-stars {
  display: flex;
  align-items: center;
}

.star {
  font-size: 48rpx;
  margin-right: 10rpx;
  color: #e5e5e5;
}

.star.active {
  color: #ffd700;
}

.rating-text {
  font-size: 28rpx;
  color: #666;
  margin-left: 20rpx;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag {
  padding: 15rpx 30rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
}

.tag.active {
  background: #07c160;
  color: white;
}

.comment-input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.image-upload {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 60rpx;
  color: #ccc;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.action-buttons {
  margin-top: 40rpx;
}

.submit-btn {
  background: #07c160;
  color: white;
  font-size: 32rpx;
  padding: 30rpx;
  border-radius: 12rpx;
  border: none;
}

.submit-btn:active {
  background: #06ad56;
}
