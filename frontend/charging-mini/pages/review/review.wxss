.container {
  padding: 24rpx;
}

.order-info {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
}

.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #495057;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #868E96;
}

.info-value {
  font-size: 26rpx;
  color: #495057;
}

.section {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #495057;
  margin-bottom: 16rpx;
}

.rating-stars {
  display: flex;
  align-items: center;
}

.star {
  font-size: 44rpx;
  margin-right: 8rpx;
  color: #E9ECEF;
}

.star.active {
  color: #FFD43B;
}

.rating-text {
  font-size: 26rpx;
  color: #868E96;
  margin-left: 16rpx;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  background: #F8F9FA;
  color: #868E96;
  font-size: 24rpx;
  border: 1rpx solid #E9ECEF;
}

.tag.active {
  background: #E6FCF5;
  color: #0CA678;
  border-color: #0CA678;
}

.comment-input {
  width: 100%;
  height: 180rpx;
  padding: 16rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #ADB5BD;
  margin-top: 8rpx;
}

.action-buttons {
  margin-top: 32rpx;
}

.submit-btn {
  background: #4DABF7;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  border: none;
}
