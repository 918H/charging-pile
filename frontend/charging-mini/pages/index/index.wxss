.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.header {
  padding: 20rpx;
  background: #fff;
}

.location {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.location .icon {
  margin-right: 10rpx;
}

.map-container {
  flex: 1;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 100%;
}

.pile-list {
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 20rpx;
  max-height: 40%;
  overflow-y: auto;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.pile-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.pile-info {
  flex: 1;
}

.pile-name {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.pile-address {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.pile-tags {
  display: flex;
  gap: 10rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  color: #666;
}

.tag.available {
  background: #e8f5e9;
  color: #4caf50;
}

.pile-distance {
  font-size: 28rpx;
  color: #409EFF;
  font-weight: bold;
}
