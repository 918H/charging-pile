.container {
  padding: 24rpx;
}

.map-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
}

.pile-item {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
}

.pile-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #343A40;
  margin-bottom: 12rpx;
}

.pile-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 26rpx;
  color: #868E96;
}

.info-value {
  font-size: 26rpx;
  color: #495057;
  font-weight: 400;
}

.status-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
}

.status-available {
  background: #E6FCF5;
  color: #0CA678;
}

.status-busy {
  background: #FFF5F5;
  color: #FA5252;
}

.status-offline {
  background: #F1F3F5;
  color: #868E96;
}

.action-btn {
  background: #4DABF7;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  border: none;
  margin-top: 16rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #ADB5BD;
  font-size: 28rpx;
}
