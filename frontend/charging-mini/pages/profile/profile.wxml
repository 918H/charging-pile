<view class="container">
  <view class="profile-header">
    <image class="avatar" src="{{avatarUrl || '/images/default-avatar.png'}}"></image>
    <view class="user-info">
      <text class="nickname">{{nickname || '点击登录'}}</text>
      <text class="phone">{{phone || '未绑定手机号'}}</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="navigateTo" data-url="/pages/order/order">
      <text class="menu-icon">📋</text>
      <text class="menu-title">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="navigateTo" data-url="/pages/wallet/wallet">
      <text class="menu-icon">💰</text>
      <text class="menu-title">我的钱包</text>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="navigateTo" data-url="/pages/coupon/coupon">
      <text class="menu-icon">🎫</text>
      <text class="menu-title">优惠券</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="navigateTo" data-url="/pages/feedback/feedback">
      <text class="menu-icon">💬</text>
      <text class="menu-title">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="navigateTo" data-url="/pages/about/about">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-title">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button class="btn-logout" wx:if="{{isLogin}}" bindtap="logout">退出登录</button>
  <button class="btn-login" wx:else bindtap="login">微信登录</button>
</view>
