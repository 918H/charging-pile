<view class="container">
  <view class="order-info-card">
    <text class="card-title">订单信息</text>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{orderInfo.orderNumber}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">支付金额</text>
      <text class="info-value">¥{{orderInfo.amount}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">支付时间</text>
      <text class="info-value">{{orderInfo.paymentTime}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">支付方式</text>
      <text class="info-value">{{paymentMethodText[orderInfo.paymentMethod]}}</text>
    </view>
  </view>

  <view class="form-section">
    <text class="section-title">退款信息</text>
    
    <view class="form-item">
      <text class="label">退款金额</text>
      <input 
        type="digit" 
        placeholder="请输入退款金额"
        value="{{refundAmount}}"
        bindinput="onRefundAmountInput"
      />
      <text class="hint">最多可退 ¥{{maxRefundAmount}}</text>
    </view>

    <view class="form-item">
      <text class="label">退款原因</text>
      <picker 
        mode="selector" 
        range="{{refundReasons}}"
        value="{{refundReasonIndex}}"
        bindchange="onRefundReasonChange"
      >
        <view class="picker-value">
          {{refundReasons[refundReasonIndex]}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">其他原因 (可选)</text>
      <textarea
        class="reason-input"
        placeholder="请详细描述退款原因"
        maxlength="200"
        value="{{otherReason}}"
        bindinput="onOtherReasonInput"
      />
      <text class="char-count">{{otherReason.length}}/200</text>
    </view>

    <view class="form-item">
      <text class="label">凭证图片 (可选)</text>
      <view class="image-upload" bindtap="chooseImage">
        <text class="upload-icon">+</text>
        <text class="upload-text">上传凭证</text>
      </view>
    </view>
  </view>

  <view class="tips-section">
    <text class="tips-title">退款说明</text>
    <view class="tips-list">
      <text class="tip-item">• 退款将在 1-3 个工作日内原路退回</text>
      <text class="tip-item">• 请确保支付账户正常可收款</text>
      <text class="tip-item">• 如有疑问请联系客服</text>
    </view>
  </view>

  <view class="action-buttons">
    <button class="submit-btn" bindtap="submitRefund">提交退款申请</button>
  </view>
</view>
