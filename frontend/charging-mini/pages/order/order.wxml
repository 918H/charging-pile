<view class="container">
  <view class="tabs">
    <view class="tab {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">充电订单</view>
    <view class="tab {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">我的预约</view>
  </view>

  <view class="order-list" wx:if="{{currentTab === 0}}">
    <view class="order-item" wx:for="{{orders}}" wx:key="orderId">
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNumber}}</text>
        <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      
      <view class="order-body">
        <view class="pile-name">{{item.pileName}}</view>
        <view class="order-info">
          <text>充电时长：{{item.durationMinutes}}分钟</text>
          <text>充电度数：{{item.powerConsumed}}度</text>
        </view>
      </view>
      
        <view class="order-footer">
        <text class="order-amount">¥{{item.totalAmount}}</text>
        <view class="order-actions">
          <button wx:if="{{item.status === 0}}" class="btn-cancel" bindtap="cancelOrder" data-id="{{item.orderId}}">取消订单</button>
          <button wx:if="{{item.status === 0}}" class="btn-pay" bindtap="payOrder" data-id="{{item.orderId}}">立即支付</button>
          <button wx:if="{{item.status === 2}}" class="btn-review" bindtap="goToReview" data-id="{{item.orderId}}">评价</button>
          <button class="btn-detail" bindtap="viewDetail" data-id="{{item.orderId}}">查看详情</button>
        </view>
      </view>
    </view>
  </view>

  <view class="reservation-list" wx:if="{{currentTab === 1}}">
    <view class="reservation-item" wx:for="{{reservations}}" wx:key="reservationId">
      <view class="reservation-header">
        <text class="reservation-no">预约 ID：{{item.reservationId}}</text>
        <text class="reservation-status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      
      <view class="reservation-body">
        <view class="pile-name">充电桩 ID：{{item.pileId}}</view>
        <view class="reservation-info">
          <text>预约时间：{{item.startTime}}</text>
          <text>时长：{{item.durationMinutes}}分钟</text>
        </view>
        <view class="reservation-fee">预估费用：¥{{item.estimatedFee}}</view>
      </view>
      
      <view class="reservation-footer">
        <view class="reservation-actions">
          <button wx:if="{{item.status === 0}}" class="btn-cancel" bindtap="cancelReservation" data-id="{{item.reservationId}}">取消预约</button>
          <button class="btn-detail" bindtap="viewReservationDetail" data-id="{{item.reservationId}}">查看详情</button>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{(currentTab === 0 && orders.length === 0) || (currentTab === 1 && reservations.length === 0)}}">
    <text wx:if="{{currentTab === 0}}">暂无充电订单</text>
    <text wx:if="{{currentTab === 1}}">暂无预约记录</text>
  </view>
</view>
