.container {
  padding: 24rpx;
}

.order-item {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 24rpx;
  color: #ADB5BD;
}

.order-status {
  font-size: 24rpx;
  font-weight: 500;
}

.status-0 { color: #FAA935; }
.status-1 { color: #4DABF7; }
.status-2 { color: #0CA678; }
.status-3 { color: #ADB5BD; }

.pile-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #343A40;
  margin-bottom: 12rpx;
}

.order-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #868E96;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F3F5;
}

.order-amount {
  font-size: 30rpx;
  font-weight: 500;
  color: #FA5252;
}

.order-actions {
  display: flex;
  gap: 12rpx;
}

.order-actions button {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 6rpx;
}

.btn-cancel {
  background: #FFFFFF;
  color: #495057;
  border: 1rpx solid #E9ECEF;
}

.btn-pay {
  background: #FAA935;
  color: #FFFFFF;
}

.btn-review {
  background: #0CA678;
  color: #FFFFFF;
}

.btn-detail {
  background: #4DABF7;
  color: #FFFFFF;
}

.tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #868E96;
  border-bottom: 3rpx solid transparent;
}

.tab.active {
  color: #4DABF7;
  border-bottom-color: #4DABF7;
  font-weight: 500;
}
