.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: #07c160;
  border-bottom-color: #07c160;
  font-weight: bold;
}

.order-item,
.reservation-item {
  background: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.order-header,
.reservation-header {
  display: flex;
  justify-content: space-between;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.order-no,
.reservation-no {
  font-size: 26rpx;
  color: #666;
}

.order-status,
.reservation-status {
  font-size: 26rpx;
  font-weight: bold;
}

.status-0 { color: #f57c00; }
.status-1 { color: #409EFF; }
.status-2 { color: #4caf50; }
.status-3 { color: #999; }

.order-body,
.reservation-body {
  padding: 20rpx;
}

.pile-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.order-info,
.reservation-info {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.reservation-fee {
  font-size: 26rpx;
  color: #f44336;
  font-weight: bold;
  margin-top: 10rpx;
}

.order-footer,
.reservation-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-top: 1rpx solid #eee;
}

.order-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #f44336;
}

.order-actions,
.reservation-actions {
  display: flex;
  gap: 20rpx;
}

.order-actions button,
.reservation-actions button {
  font-size: 26rpx;
  padding: 10rpx 30rpx;
  border-radius: 6rpx;
}

.btn-cancel {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.btn-pay {
  background: #f57c00;
  color: #fff;
}

.btn-detail {
  background: #409EFF;
  color: #fff;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
