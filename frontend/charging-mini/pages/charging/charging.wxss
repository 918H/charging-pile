.container {
  padding: 24rpx;
}

.charging-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
}

.status-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #0CA678;
}

.progress-section {
  text-align: center;
  margin-bottom: 32rpx;
}

.soc-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 16rpx;
}

.soc-value {
  font-size: 80rpx;
  font-weight: 300;
  color: #0CA678;
}

.soc-unit {
  font-size: 28rpx;
  color: #ADB5BD;
  margin-left: 8rpx;
}

.soc-label {
  font-size: 26rpx;
  color: #868E96;
  margin-bottom: 16rpx;
}

.soc-bar {
  width: 100%;
  height: 12rpx;
  background: #E9ECEF;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.soc-bar-fill {
  height: 100%;
  background: #4DABF7;
  border-radius: 6rpx;
}

.target-soc {
  font-size: 24rpx;
  color: #ADB5BD;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.info-item {
  text-align: center;
  padding: 16rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: #868E96;
  margin-bottom: 8rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #495057;
}

.battery-info {
  border-top: 1rpx solid #E9ECEF;
  padding-top: 16rpx;
  margin-top: 16rpx;
}

.action-buttons {
  margin-top: 32rpx;
}

.stop-btn {
  background: #FA5252;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  border: none;
}
