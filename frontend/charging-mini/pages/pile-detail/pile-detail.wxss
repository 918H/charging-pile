.container {
  padding: 24rpx;
}

.header {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
}

.pile-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #343A40;
  margin-bottom: 8rpx;
}

.status-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
}

.status-0 { background: #F1F3F5; color: #868E96; }
.status-1 { background: #E7F5FF; color: #228BE6; }
.status-2 { background: #E6FCF5; color: #0CA678; }
.status-3 { background: #FFF5F5; color: #FA5252; }

.info-section {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #868E96;
}

.info-value {
  font-size: 26rpx;
  color: #495057;
}

.slots-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.slot-item {
  border-radius: 8rpx;
  padding: 24rpx;
  text-align: center;
  border: 1rpx solid #E9ECEF;
}

.slot-0 { background: #F1F3F5; }
.slot-1 { background: #E7F5FF; }
.slot-2 { background: #E6FCF5; }
.slot-3 { background: #FFF5F5; }

.slot-number {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #495057;
  margin-bottom: 8rpx;
}

.slot-status {
  display: block;
  font-size: 22rpx;
  color: #868E96;
}

.option-item {
  margin-bottom: 24rpx;
}

.option-label {
  display: block;
  font-size: 26rpx;
  color: #495057;
  margin-bottom: 12rpx;
}

.picker-value {
  font-size: 26rpx;
  color: #495057;
  padding: 16rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
}

.coupon-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx;
  border-bottom: 1rpx solid #F1F3F5;
}

.coupon-amount {
  font-size: 32rpx;
  font-weight: 500;
  color: #FA5252;
}

.coupon-name {
  font-size: 26rpx;
  color: #495057;
}

.action-buttons {
  margin-top: 32rpx;
}

.start-btn {
  background: #4DABF7;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  border: none;
  margin-bottom: 12rpx;
}

.cancel-btn {
  background: #F8F9FA;
  color: #495057;
  font-size: 28rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  border: 1rpx solid #E9ECEF;
}
