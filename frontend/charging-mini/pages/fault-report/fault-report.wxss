.container {
  padding: 24rpx;
}

.form-section {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #495057;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.picker-value,
input {
  padding: 16rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #495057;
}

.desc-input {
  width: 100%;
  height: 180rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #ADB5BD;
  margin-top: 8rpx;
}

.image-upload {
  width: 180rpx;
  height: 180rpx;
  border: 1rpx dashed #DEE2E6;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 50rpx;
  color: #DEE2E6;
}

.upload-text {
  font-size: 22rpx;
  color: #ADB5BD;
}

.tips-section {
  background: #FFF9DB;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #FFE9A6;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #495057;
  margin-bottom: 12rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #868E96;
}

.action-buttons {
  margin-top: 32rpx;
}

.submit-btn {
  background: #FFA94D;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  border: none;
}
