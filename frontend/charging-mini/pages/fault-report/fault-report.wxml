<view class="container">
  <view class="form-section">
    <view class="form-item">
      <text class="label">故障类型</text>
      <picker mode="selector" range="{{faultTypes}}" value="{{faultTypeIndex}}" bindchange="onFaultTypeChange">
        <view class="picker-value">
          {{faultTypes[faultTypeIndex]}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">故障桩号 (可选)</text>
      <input type="number" placeholder="请输入充电桩编号" value="{{pileCode}}" bindinput="onPileCodeInput" />
    </view>

    <view class="form-item">
      <text class="label">故障描述</text>
      <textarea 
        class="desc-input"
        placeholder="请详细描述故障情况..."
        maxlength="200"
        value="{{description}}"
        bindinput="onDescInput"
      />
      <text class="char-count">{{description.length}}/200</text>
    </view>

    <view class="form-item">
      <text class="label">联系电话</text>
      <input type="number" placeholder="方便我们联系您" value="{{contactPhone}}" bindinput="onPhoneInput" />
    </view>

    <view class="form-item">
      <text class="label">现场照片 (可选)</text>
      <view class="image-upload" bindtap="chooseImage">
        <text class="upload-icon">+</text>
        <text class="upload-text">上传图片</text>
      </view>
    </view>
  </view>

  <view class="tips-section">
    <text class="tips-title">温馨提示</text>
    <view class="tips-list">
      <text class="tip-item">• 我们会安排专业人员处理</text>
      <text class="tip-item">• 处理完成后会电话通知您</text>
      <text class="tip-item">• 紧急问题请拨打客服电话</text>
    </view>
  </view>

  <view class="action-buttons">
    <button class="submit-btn" bindtap="submitReport">提交上报</button>
  </view>
</view>
