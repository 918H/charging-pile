page {
  background: #F8F9FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 24rpx;
  background: #F8F9FA;
  min-height: 100vh;
}

.card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E9ECEF;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #495057;
  margin-bottom: 16rpx;
}

.btn-primary {
  background: #4DABF7;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  border: none;
  font-weight: 400;
}

.btn-primary:active {
  background: #339AF0;
}

.btn-secondary {
  background: #F1F3F5;
  color: #495057;
  font-size: 28rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  border: none;
}

.text-primary {
  color: #4DABF7;
}

.text-secondary {
  color: #868E96;
}

.text-muted {
  color: #ADB5BD;
}

.divider {
  height: 1rpx;
  background: #E9ECEF;
  margin: 16rpx 0;
}
